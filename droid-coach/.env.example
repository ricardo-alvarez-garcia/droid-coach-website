# These are SERVER settings, never frontend settings. Do not commit real secrets.
# Set them in your shell or hosting service's secret manager. No .env auto-loading.
FACTORY_API_KEY=
FACTORY_COMPUTER_ID=
COACH_PUBLIC_ORIGIN=
COACH_DAILY_TURNS=20
COACH_HOURLY_TURNS_PER_IP=6
COACH_TURN_TIMEOUT=120
# Factory's API may not report session settings back. Set to 1 to send questions
# anyway; reported settings that contradict no-tools/autonomy-off still block chat.
COACH_ALLOW_UNVERIFIED_POLICY=0
# Use persistent storage in production.
# COACH_DATABASE=/app/web/data/usage.db
